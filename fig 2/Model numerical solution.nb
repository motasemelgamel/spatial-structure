Cell[CellGroupData[{

Cell["Beta sweeps at fixed theta", "Subsection",ExpressionUUID->"5aa19858-d42f-400f-915e-c60a056e5f4e"],

Cell["\<\
Preserve the logarithmic beta grid and listed fixed theta values. Evaluate \
the parameter pairs across available parallel kernels, stop only after a \
guarded steady-state check, and export one named tab per theta.\
\>", "Text",
 CellChangeTimes->{
  3.993599860507501*^9},ExpressionUUID->"59969826-cfbf-4a93-9ae8-\
e44da6888450"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Configure", " ", "numerical", " ", "steady"}], "-", 
    RowBox[{
    "state", " ", "checks", " ", "and", " ", "define", " ", "one", " ", 
     "independent", " ", "single"}], "-", 
    RowBox[{"resource", " ", 
     RowBox[{"solve", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", "1000"}], ";", 
    RowBox[{"thresh", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}], ";", 
    RowBox[{"steadyStateTolerance", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "4"]]}], ";", 
    RowBox[{"steadyStateMinimumTime", "=", "100"}], ";", 
    RowBox[{"steadyStateCheckInterval", "=", "25"}], ";", 
    RowBox[{"steadyStateAbundanceSafetyFactor", "=", "10"}], ";", 
    RowBox[{"ClearAll", "[", 
     RowBox[{"integrationEndTime", ",", "singleResourceSurvivalAt"}], "]"}], 
    ";", 
    RowBox[{
     RowBox[{"integrationEndTime", "[", "solution_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "functions", "}"}], ",", 
       RowBox[{
        RowBox[{"functions", "=", 
         RowBox[{"Head", "/@", "solution"}]}], ";", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"First", "[", 
              RowBox[{"#1", "[", "\"\<Domain\>\"", "]"}], "]"}], "]"}], "&"}],
            ")"}], "/@", "functions"}], "]"}]}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"singleResourceSurvivalAt", "[", 
      RowBox[{
       RowBox[{"thetaValue_", "?", "NumericQ"}], ",", 
       RowBox[{"betaValue_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numericEquations", ",", "equationRightSides", ",", "stateVector", 
         ",", "extinctionConditions", ",", "extinctionActions", ",", 
         "extinctionEvents", ",", "classificationStable", ",", 
         "steadyStateCheckTimes", ",", "steadyStateEvents", ",", "solution", 
         ",", "finalTime", ",", "finalState", ",", "finalAbundances"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"numericEquations", "=", 
         RowBox[{"eq", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]", "->", "thetaValue"}], ",", 
            RowBox[{"\[Beta]", "->", "betaValue"}]}], "}"}]}]}], ";", 
        RowBox[{"equationRightSides", "=", 
         RowBox[{"Last", "/@", "numericEquations"}]}], ";", 
        RowBox[{"stateVector", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], ",", 
           RowBox[{"T", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"R", "[", "t", "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"extinctionConditions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "<", "thresh"}], "]"}]}], ";", 
        RowBox[{"extinctionActions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "->", "0"}], "]"}]}], ";", 
        RowBox[{"extinctionEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionConditions", ",", "speciesIndex"}], "]"}], 
              "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionActions", ",", "speciesIndex"}], "]"}], 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"speciesIndex", ",", "S"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"classificationStable", "=", 
         RowBox[{"And", "@@", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", "==", "0"}], "||", 
              RowBox[{"#1", ">=", 
               RowBox[{
               "steadyStateAbundanceSafetyFactor", " ", "thresh"}]}]}], "&"}],
             ")"}], "/@", 
           RowBox[{"n", "[", "t", "]"}]}]}]}], ";", 
        RowBox[{"steadyStateCheckTimes", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
          "steadyStateMinimumTime", ",", "lim", ",", 
           "steadyStateCheckInterval"}], "]"}]}], ";", 
        RowBox[{"steadyStateEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"checkTime", "=", "scheduledTime"}], "}"}], ",", 
             RowBox[{"WhenEvent", "[", 
              RowBox[{
               RowBox[{"Evaluate", "[", 
                RowBox[{
                 RowBox[{"t", "==", "checkTime"}], "&&", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"Abs", "[", "equationRightSides", "]"}], "]"}], 
                  "<", "steadyStateTolerance"}], "&&", 
                 "classificationStable"}], "]"}], ",", 
               "\"\<StopIntegration\>\""}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"scheduledTime", ",", "steadyStateCheckTimes"}], "}"}]}], 
          "]"}]}], ";", 
        RowBox[{"solution", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
            "numericEquations", ",", "incond", ",", "extinctionEvents", ",", 
             "steadyStateEvents"}], "]"}], ",", "stateVector", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "lim"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"finalTime", "=", 
         RowBox[{"integrationEndTime", "[", "solution", "]"}]}], ";", 
        RowBox[{"finalState", "=", 
         RowBox[{"N", "[", 
          RowBox[{"solution", "/.", " ", 
           RowBox[{"t", "->", "finalTime"}]}], "]"}]}], ";", 
        RowBox[{"finalAbundances", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"finalState", ",", "S"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           FractionBox[
            RowBox[{"Count", "[", 
             RowBox[{"finalAbundances", ",", 
              RowBox[{"abundance_", "/;", 
               RowBox[{
                RowBox[{"NumericQ", "[", "abundance", "]"}], "&&", 
                RowBox[{"abundance", ">", "thresh"}]}]}]}], "]"}], "S"], 
           "]"}], ",", "finalTime"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Preserve", " ", "the", " ", "original", " ", "logarithmic", " ", "beta",
       " ", "spacing", " ", "and", " ", "listed", " ", "fixed"}], "-", 
     RowBox[{"theta", " ", 
      RowBox[{"cases", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logspace", "[", 
      RowBox[{"a_", ",", "b_", ",", "numberOfPoints_"}], "]"}], ":=", 
     SuperscriptBox["10.`", 
      RowBox[{"Range", "[", 
       RowBox[{"a", ",", "b", ",", 
        FractionBox[
         RowBox[{"b", "-", "a"}], 
         RowBox[{"numberOfPoints", "-", "1"}]]}], "]"}]]}], ";", 
    RowBox[{"betaSweepGrid", "=", 
     RowBox[{"logspace", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3", ",", "50"}], "]"}]}], ";", 
    RowBox[{"betaSweepThetaValues", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0.3`", ",", "0.5`", ",", "0.8`", ",", "1"}], "}"}]}],
     ";", 
    RowBox[{"betaSweepTasks", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<theta\>\"", "->", "thetaValue"}], ",", 
           RowBox[{"\"\<beta\>\"", "->", "betaValue"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"thetaValue", ",", "betaSweepThetaValues"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"betaValue", ",", "betaSweepGrid"}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Launch", " ", "available", " ", "kernels"}], ",", " ", 
     RowBox[{"distribute", " ", "the", " ", "model", " ", "once"}], ",", " ", 
     
     RowBox[{"and", " ", "solve", " ", "parameter", " ", "pairs", " ", 
      RowBox[{"concurrently", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$KernelCount", "==", "0"}], ",", 
      RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "integrationEndTime", ",", "singleResourceSurvivalAt", ",", "eq", ",", 
      "incond", ",", "n", ",", "T", ",", "t", ",", "S", ",", "lim", ",", 
      "thresh", ",", "steadyStateTolerance", ",", "steadyStateMinimumTime", 
      ",", "steadyStateCheckInterval", ",", 
      "steadyStateAbundanceSafetyFactor"}], "]"}], ";", 
    RowBox[{"betaSweepResults", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"task", ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"solveResult", "=", 
             RowBox[{"singleResourceSurvivalAt", "[", 
              RowBox[{
               RowBox[{"task", "[", "\"\<theta\>\"", "]"}], ",", 
               RowBox[{"task", "[", "\"\<beta\>\"", "]"}]}], "]"}]}], "}"}], 
           ",", 
           RowBox[{"Join", "[", 
            RowBox[{"task", ",", 
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"\"\<survivingFraction\>\"", "->", 
                RowBox[{"First", "[", "solveResult", "]"}]}], ",", 
               RowBox[{"\"\<stopTime\>\"", "->", 
                RowBox[{"Last", "[", "solveResult", "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}], "]"}], ",", "betaSweepTasks", ",", 
       RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Assemble", " ", "worksheets", " ", "in", " ", "the", " ", "original", 
      " ", "theta", " ", "order"}], ";", " ", 
     RowBox[{
     "stop", " ", "times", " ", "remain", " ", "available", " ", "in", " ", 
      RowBox[{"betaSweepResults", "."}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaSweepSheets", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "sweepRows", "}"}], ",", 
         RowBox[{
          RowBox[{"sweepRows", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#1", "[", "\"\<beta\>\"", "]"}], ",", 
                RowBox[{"#1", "[", "\"\<survivingFraction\>\"", "]"}]}], 
               "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"betaSweepResults", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "[", "\"\<theta\>\"", "]"}], "===", 
                "fixedTheta"}], "&"}]}], "]"}]}]}], ";", 
          RowBox[{
           RowBox[{"\"\<theta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"fixedTheta", ",", "InputForm"}], "]"}]}], "->", 
           RowBox[{"Prepend", "[", 
            RowBox[{"sweepRows", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<beta\>\"", ",", "\"\<surviving_fraction\>\""}], 
              "}"}]}], "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"fixedTheta", ",", "betaSweepThetaValues"}], "}"}]}], "]"}]}],
     ";", 
    RowBox[{"betaSweepWorkbook", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<beta_sweeps_at_fixed_theta.xlsx\>\""}], "}"}], "]"}]}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{
     "betaSweepWorkbook", ",", "betaSweepSheets", ",", "\"\<XLSX\>\""}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.974712311065768*^9, 3.974712337659648*^9}, {
   3.974712453857809*^9, 3.974712505485009*^9}, 3.974799255466337*^9, {
   3.980892431340281*^9, 3.980892608155969*^9}, {3.980892656267294*^9, 
   3.980892673968364*^9}, {3.980893280159321*^9, 3.980893282697317*^9}, {
   3.980893390665097*^9, 3.98089343116706*^9}, {3.980935088221012*^9, 
   3.980935097384593*^9}, 3.980937040667518*^9, 3.980937166105709*^9, {
   3.993599807512678*^9, 3.993599808681726*^9}, 3.993629974993325*^9, 
   3.99368219636909*^9, 3.993682484802987*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"ec89ee98-63a1-4036-813f-5142c08aeaca"]
}, Open  ]]
