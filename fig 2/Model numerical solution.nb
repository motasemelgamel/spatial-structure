Cell["Susceptibility map", "Subsection",ExpressionUUID->"fa4b8f41-834e-4528-8287-e34e2da90fdd"],

Cell["\<\
Load the Parula-like color function and map log10 of the absolute \
susceptibility across theta and beta. Internet access is required only for \
the external color-map import.\
\>", "Text",ExpressionUUID->"d02f3a13-4047-4a02-8a6a-098541caffc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"load", " ", "matlab", " ", "colormap"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Import", "[", 
    RowBox[{
    "\"\<https://pastebin.com/raw/uUJ4rmc1\>\"", ",", "\"\<Package\>\""}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "plot", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"susceptibilityPlot", "=", 
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"Log10", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"suscN1k1", "[", 
         RowBox[{"\[Theta]", ",", "\[Beta]"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0.05", ",", "0.95"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", 
        SuperscriptBox["10", 
         RowBox[{"-", "4"}]], ",", 
        SuperscriptBox["10", "4"]}], "}"}], ",", 
      RowBox[{"ScalingFunctions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
      RowBox[{"ColorFunction", "->", "parulaNew"}], ",", 
      RowBox[{"PlotRange", "->", "Full"}]}], "]"}]}]}]}]], "Input",
