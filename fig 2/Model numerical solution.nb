Cell[CellGroupData[{

Cell["Parametric solver", "Subsection",ExpressionUUID->"cf84aaae-a5a1-46c5-a26a-6b250ec4f532"],

Cell["\<\
Build extinction events that clamp a species abundance to zero after it \
crosses the threshold. ParametricNDSolve then exposes abundance trajectories \
and the survivor-fraction function for arbitrary theta and beta within the \
explored domain.\
\>", "Text",ExpressionUUID->"a862ee8f-8f1e-47d0-86ea-49e319cb65ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "parametric", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", " ", "1000"}], ";", 
    RowBox[{"thresh", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"n", "[", "t", "]"}], "<", "thresh"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"n", "[", "t", "]"}], "->", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
