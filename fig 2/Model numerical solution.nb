Cell[CellGroupData[{

Cell["Abundance trajectories for selected theta values", "Subsection",ExpressionUUID->"962501ad-74b6-425d-b4d5-76b901bb61f4"],

Cell["\<\
Solve the model at theta = 0, 0.5, and 1 with beta fixed at 1. Sample every \
species abundance directly from the numerical interpolating functions at \
regular time intervals, then export one workbook with a separate named tab \
for each theta value.\
\>", "Text",
 CellChangeTimes->{{3.993596136126742*^9, 
  3.993596136633517*^9}},ExpressionUUID->"52a54e8a-738a-436d-a2f7-\
a224def6be08"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
  "(*", " ", "Sampling", " ", "and", " ", "export", " ", "settings", " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaValue", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaValues", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0.5`", ",", "1"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeStep", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sampleTimes", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "lim", ",", "timeStep"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"headers", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\"\<species_\>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "S"}], "}"}]}], "]"}], ",", "\"\<time\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Solve", " ", "each", " ", "theta", " ", "value", " ", "and", " ", 
     "sample", " ", "all", " ", "species", " ", "directly", " ", "from", " ", 
     "the", " ", "interpolating", " ", "functions"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"abundanceSheets", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "solutionRules", ",", "abundanceFunctions", ",", "abundanceRows"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"solutionRules", "=", 
           RowBox[{"First", "[", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Theta]", "=", "thetaValue"}], ",", 
                RowBox[{"\[Beta]", "=", "betaValue"}]}], "}"}], ",", 
              RowBox[{"NDSolve", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{"eq", ",", "incond"}], "]"}], ",", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"n", "[", "t", "]"}], ",", 
                  RowBox[{"T", "[", "t", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"R", "[", "t", "]"}], "}"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "0", ",", "lim"}], "}"}]}], "]"}]}], "]"}],
             "]"}]}], ";", 
          RowBox[{"abundanceFunctions", "=", 
           RowBox[{
            RowBox[{"n", "[", "t", "]"}], "/.", " ", "solutionRules"}]}], ";", 
          RowBox[{"abundanceRows", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"abundanceFunctions", "/.", " ", 
                 RowBox[{"t", "->", "sampleTime"}]}], "]"}], ",", 
               "sampleTime"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"sampleTime", ",", "sampleTimes"}], "}"}]}], "]"}]}], 
          ";", 
          RowBox[{
           RowBox[{"\"\<theta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"thetaValue", ",", "InputForm"}], "]"}]}], "->", 
           RowBox[{"Prepend", "[", 
            RowBox[{"abundanceRows", ",", "headers"}], "]"}]}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"thetaValue", ",", "thetaValues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Write", " ", "one", " ", "workbook", " ", "with", " ", "one", " ", 
     "named", " ", "tab", " ", "per", " ", "theta", " ", "value"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Restart", " ", "Java", " ", "with", " ", "enough", " ", "heap", " ", 
     "for", " ", "the", " ", "large", " ", "XLSX", " ", "workbook"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<JLink`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JLink`InstallJava", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JLink`ReinstallJava", "[", 
     RowBox[{
      RowBox[{"JLink`CommandLine", "->", "\"\<java\>\""}], ",", 
      RowBox[{"JLink`JVMArguments", "->", "\"\<-Xmx4096m\>\""}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"abundanceWorkbook", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<species_abundances_by_theta.xlsx\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"abundanceWorkbook", ",", 
     RowBox[{"\"\<Sheets\>\"", "->", "abundanceSheets"}], ",", 
     "\"\<Rules\>\""}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9745124007463417`*^9, 3.974512406165593*^9}, 
   3.974512439070869*^9, {3.9745125012801037`*^9, 3.97451250904279*^9}, {
   3.974512551505707*^9, 3.974512622317834*^9}, {3.974512745937999*^9, 
   3.974512764136194*^9}, 3.974512930843975*^9, {3.974512969949288*^9, 
   3.974513107737273*^9}, {3.974513138031084*^9, 3.974513175973544*^9}, 
   3.9745132099508877`*^9, {3.974513242765841*^9, 3.9745133852549553`*^9}, {
   3.9745134166360483`*^9, 3.974513465121538*^9}, {3.974513500538487*^9, 
   3.9745136804750347`*^9}, {3.974515290862502*^9, 3.974515297361125*^9}, {
   3.974515355695754*^9, 3.974515360868201*^9}, {3.974515634524097*^9, 
   3.9745156404858217`*^9}, 3.974516074784563*^9, 3.974537843566862*^9, {
   3.974650265636586*^9, 3.974650326878078*^9}, {3.974988289070356*^9, 
   3.974988305652761*^9}, {3.974988353120998*^9, 3.974988380512857*^9}, {
   3.97498895532765*^9, 3.974989049436474*^9}, {3.9749891174794693`*^9, 
   3.974989138281954*^9}, {3.974989183025004*^9, 3.974989194688964*^9}, {
   3.974989315283442*^9, 3.974989327338757*^9}, {3.97498936456185*^9, 
   3.974989365855627*^9}, {3.974989401122864*^9, 3.974989405890967*^9}, {
   3.974989474630246*^9, 3.974989483169258*^9}, {3.974991411432125*^9, 
   3.974991412106689*^9}, {3.974991479138139*^9, 3.974991516853051*^9}, 
   3.975082510691377*^9, {3.97508255752667*^9, 3.975082558347683*^9}, {
   3.976875492837729*^9, 3.976875495136862*^9}, {3.976894855494779*^9, 
   3.9768948991456223`*^9}, {3.9774960158395233`*^9, 3.977496028116559*^9}, {
   3.977586584139977*^9, 3.977586591605194*^9}, {3.980892389539521*^9, 
   3.980892390451844*^9}, {3.993596976878447*^9, 3.993596977480048*^9}, 
