Cell[CellGroupData[{
Cell["Model numerical solution", "Title",
 CellChangeTimes->{{3.993724823251059*^9, 
  3.993724828319572*^9}},ExpressionUUID->"21f5c87d-ad51-4429-a55c-\
fd387591cbbd"],

Cell["\<\
Disclaimer: This notebook was written and revised with assistance from OpenAI \
