   3.974540998026655*^9}, {3.974541456311439*^9, 3.974541456405304*^9}, {
   3.974542935519683*^9, 3.97454293567816*^9}, {3.974543610495*^9, 
   3.974543611340392*^9}, {3.974543652792234*^9, 3.974543653353005*^9}, {
