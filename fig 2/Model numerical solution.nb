Cell[CellGroupData[{

Cell["2. Two-species susceptibility analysis", "Section",ExpressionUUID->"43d593f9-100f-44d9-9d92-f200dfec1dc0"],

Cell["\<\
This section starts with ClearAll and is independent of Section 1. It uses \
two nearby alpha values, solves their equilibrium numerically, constructs \
linear-response coefficients A1 through C3, and defines the susceptibility of \
species 1 abundance to its mortality perturbation.
This section can be used to reproduce the susceptibility map in figure 3, but \
it was not used in the paper. The uploaded susceptibility Matlab code was \
used instead for a faster output.\
\>", "Text",
 CellChangeTimes->{{3.993641453584002*^9, 3.993641553862897*^9}, {
  3.993658998446905*^9, 
  3.9936590057953663`*^9}},ExpressionUUID->"7d79071e-64e6-4cd5-a811-\
3edd95a6fb00"],

Cell[CellGroupData[{

Cell["Model, equilibrium evaluators, and response coefficients", "Subsection",ExpressionUUID->"449f1fdb-8686-4797-8f81-fb2480497a92"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "1"}], ";", " ", 
  RowBox[{"\[Gamma]", "=", "0.01"}], ";", " ", 
  RowBox[{"Rstar", "=", "5"}], ";", "  ", 
  RowBox[{"S", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"{", 
    RowBox[{"4.95", ",", "5.05"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "t_", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<n\>\"", "<>", 
        RowBox[{"ToString", "@", "i"}]}], "]"}], "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "t_", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<T\>\"", "<>", 
        RowBox[{"ToString", "@", "i"}]}], "]"}], "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"1", ",", "S"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"Rstar", ",", "S"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incond", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"n", "[", "0", "]"}], "==", "n0"}], "]"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"T", "[", "0", "]"}], "==", "T0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"R", "[", "0", "]"}], "==", "Rstar"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eq", "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"R", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{"Rstar", " ", "-", " ", 
         RowBox[{"R", "[", "t", "]"}], "-", 
         RowBox[{"\[Beta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"S", " ", 
             RowBox[{"R", "[", "t", "]"}]}], " ", "-", 
            RowBox[{"Total", "[", 
             RowBox[{"T", "[", "t", "]"}], "]"}]}], ")"}]}], " ", "-", " ", 
         RowBox[{"\[Gamma]", " ", 
          RowBox[{"R", "[", "t", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Theta]"}], ")"}], " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Thread", "[", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"n", "[", "t", "]"}]}], "]"}], "]"}]}]}]}], "}"}], ",", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"n", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"n", "[", "t", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Theta]", " ", 
             RowBox[{"T", "[", "t", "]"}]}], "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Theta]"}], ")"}], " ", 
             RowBox[{"R", "[", "t", "]"}]}]}], " ", ")"}]}], "-", 
         RowBox[{"k", " ", 
          RowBox[{"n", "[", "t", "]"}]}]}]}], "]"}], "\[IndentingNewLine]", 
      ",", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"T", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{"\[Beta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"R", "[", "t", "]"}], " ", "-", " ", 
            RowBox[{"T", "[", "t", "]"}]}], ")"}]}], " ", "-", " ", 
         RowBox[{"\[Alpha]", " ", "\[Gamma]", " ", "\[Theta]", " ", 
          RowBox[{"T", "[", "t", "]"}], " ", 
          RowBox[{"n", "[", "t", "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lim", "=", " ", "1000"}], ";", 
  RowBox[{"thresh", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"n", "[", "t", "]"}], "<", "thresh"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"n", "[", "t", "]"}], "->", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"events", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"WhenEvent", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "x", "]"}], "]"}], "//", "Evaluate"}], ",", 
        RowBox[{
         RowBox[{"b", "[", 
          RowBox[{"[", "x", "]"}], "]"}], "//", "Evaluate"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "S"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
