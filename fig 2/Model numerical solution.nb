Cell[CellGroupData[{

Cell["Theta sweeps at fixed beta", "Subsection",ExpressionUUID->"661523d5-7140-4c2c-84b6-3e0d48770fb3"],

Cell["\<\
Create independent theta/beta tasks on the original theta grid from 0 to 1 in \
steps of 0.05. Evaluate the tasks across available parallel kernels, stop \
only after a guarded steady-state check, and export one named tab per beta.\
\>", "Text",
 CellChangeTimes->{
  3.993599799455141*^9},ExpressionUUID->"04483332-0e9d-4cd5-83a2-\
25b545ffec8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Configure", " ", "numerical", " ", "steady"}], "-", 
    RowBox[{
    "state", " ", "checks", " ", "and", " ", "define", " ", "one", " ", 
     "independent", " ", "single"}], "-", 
    RowBox[{"resource", " ", 
     RowBox[{"solve", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", "1000"}], ";", 
    RowBox[{"thresh", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}], ";", 
    RowBox[{"steadyStateTolerance", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "4"]]}], ";", 
    RowBox[{"steadyStateMinimumTime", "=", "100"}], ";", 
    RowBox[{"steadyStateCheckInterval", "=", "25"}], ";", 
    RowBox[{"steadyStateAbundanceSafetyFactor", "=", "10"}], ";", 
    RowBox[{"ClearAll", "[", 
     RowBox[{"integrationEndTime", ",", "singleResourceSurvivalAt"}], "]"}], 
    ";", 
    RowBox[{
     RowBox[{"integrationEndTime", "[", "solution_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "functions", "}"}], ",", 
       RowBox[{
        RowBox[{"functions", "=", 
         RowBox[{"Head", "/@", "solution"}]}], ";", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"First", "[", 
              RowBox[{"#1", "[", "\"\<Domain\>\"", "]"}], "]"}], "]"}], "&"}],
            ")"}], "/@", "functions"}], "]"}]}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"singleResourceSurvivalAt", "[", 
      RowBox[{
       RowBox[{"thetaValue_", "?", "NumericQ"}], ",", 
       RowBox[{"betaValue_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numericEquations", ",", "equationRightSides", ",", "stateVector", 
         ",", "extinctionConditions", ",", "extinctionActions", ",", 
         "extinctionEvents", ",", "classificationStable", ",", 
         "steadyStateCheckTimes", ",", "steadyStateEvents", ",", "solution", 
         ",", "finalTime", ",", "finalState", ",", "finalAbundances"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"numericEquations", "=", 
         RowBox[{"eq", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]", "->", "thetaValue"}], ",", 
            RowBox[{"\[Beta]", "->", "betaValue"}]}], "}"}]}]}], ";", 
        RowBox[{"equationRightSides", "=", 
         RowBox[{"Last", "/@", "numericEquations"}]}], ";", 
        RowBox[{"stateVector", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], ",", 
           RowBox[{"T", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"R", "[", "t", "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"extinctionConditions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "<", "thresh"}], "]"}]}], ";", 
        RowBox[{"extinctionActions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "->", "0"}], "]"}]}], ";", 
        RowBox[{"extinctionEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionConditions", ",", "speciesIndex"}], "]"}], 
              "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionActions", ",", "speciesIndex"}], "]"}], 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"speciesIndex", ",", "S"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"classificationStable", "=", 
         RowBox[{"And", "@@", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", "==", "0"}], "||", 
              RowBox[{"#1", ">=", 
               RowBox[{
               "steadyStateAbundanceSafetyFactor", " ", "thresh"}]}]}], "&"}],
             ")"}], "/@", 
           RowBox[{"n", "[", "t", "]"}]}]}]}], ";", 
        RowBox[{"steadyStateCheckTimes", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
          "steadyStateMinimumTime", ",", "lim", ",", 
           "steadyStateCheckInterval"}], "]"}]}], ";", 
        RowBox[{"steadyStateEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"checkTime", "=", "scheduledTime"}], "}"}], ",", 
             RowBox[{"WhenEvent", "[", 
              RowBox[{
               RowBox[{"Evaluate", "[", 
                RowBox[{
                 RowBox[{"t", "==", "checkTime"}], "&&", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"Abs", "[", "equationRightSides", "]"}], "]"}], 
                  "<", "steadyStateTolerance"}], "&&", 
                 "classificationStable"}], "]"}], ",", 
               "\"\<StopIntegration\>\""}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"scheduledTime", ",", "steadyStateCheckTimes"}], "}"}]}], 
          "]"}]}], ";", 
        RowBox[{"solution", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
            "numericEquations", ",", "incond", ",", "extinctionEvents", ",", 
             "steadyStateEvents"}], "]"}], ",", "stateVector", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "lim"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"finalTime", "=", 
         RowBox[{"integrationEndTime", "[", "solution", "]"}]}], ";", 
        RowBox[{"finalState", "=", 
         RowBox[{"N", "[", 
          RowBox[{"solution", "/.", " ", 
           RowBox[{"t", "->", "finalTime"}]}], "]"}]}], ";", 
        RowBox[{"finalAbundances", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"finalState", ",", "S"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           FractionBox[
            RowBox[{"Count", "[", 
             RowBox[{"finalAbundances", ",", 
              RowBox[{"abundance_", "/;", 
               RowBox[{
                RowBox[{"NumericQ", "[", "abundance", "]"}], "&&", 
                RowBox[{"abundance", ">", "thresh"}]}]}]}], "]"}], "S"], 
           "]"}], ",", "finalTime"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Preserve", " ", "the", " ", "current", " ", "theta", " ", "grid", " ", 
      "and", " ", "the", " ", "listed", " ", "fixed"}], "-", 
     RowBox[{"beta", " ", 
      RowBox[{"cases", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaSweepGrid", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"thetaValue", ",", 
       RowBox[{"{", 
        RowBox[{"thetaValue", ",", "0", ",", "1", ",", "0.05`"}], "}"}]}], 
      "]"}]}], ";", 
    RowBox[{"thetaSweepBetaValues", "=", 
     RowBox[{"{", 
      RowBox[{
      "0.001`", ",", "0.01`", ",", "0.1`", ",", "1", ",", "10", ",", "100", 
       ",", "1000"}], "}"}]}], ";", 
    RowBox[{"thetaSweepTasks", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<beta\>\"", "->", "betaValue"}], ",", 
           RowBox[{"\"\<theta\>\"", "->", "thetaValue"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"betaValue", ",", "thetaSweepBetaValues"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"thetaValue", ",", "thetaSweepGrid"}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Launch", " ", "available", " ", "kernels"}], ",", " ", 
     RowBox[{"distribute", " ", "the", " ", "model", " ", "once"}], ",", " ", 
     
     RowBox[{"and", " ", "solve", " ", "parameter", " ", "pairs", " ", 
      RowBox[{"concurrently", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$KernelCount", "==", "0"}], ",", 
      RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "integrationEndTime", ",", "singleResourceSurvivalAt", ",", "eq", ",", 
      "incond", ",", "n", ",", "T", ",", "t", ",", "S", ",", "lim", ",", 
      "thresh", ",", "steadyStateTolerance", ",", "steadyStateMinimumTime", 
      ",", "steadyStateCheckInterval", ",", 
      "steadyStateAbundanceSafetyFactor"}], "]"}], ";", 
    RowBox[{"thetaSweepResults", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"task", ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"solveResult", "=", 
             RowBox[{"singleResourceSurvivalAt", "[", 
              RowBox[{
               RowBox[{"task", "[", "\"\<theta\>\"", "]"}], ",", 
               RowBox[{"task", "[", "\"\<beta\>\"", "]"}]}], "]"}]}], "}"}], 
           ",", 
           RowBox[{"Join", "[", 
            RowBox[{"task", ",", 
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"\"\<survivingFraction\>\"", "->", 
                RowBox[{"First", "[", "solveResult", "]"}]}], ",", 
               RowBox[{"\"\<stopTime\>\"", "->", 
                RowBox[{"Last", "[", "solveResult", "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}], "]"}], ",", "thetaSweepTasks", ",", 
       RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Assemble", " ", "worksheets", " ", "in", " ", "the", " ", "original", 
      " ", "beta", " ", "order"}], ";", " ", 
     RowBox[{
     "stop", " ", "times", " ", "remain", " ", "available", " ", "in", " ", 
      RowBox[{"thetaSweepResults", "."}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaSweepSheets", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "sweepRows", "}"}], ",", 
         RowBox[{
          RowBox[{"sweepRows", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#1", "[", "\"\<theta\>\"", "]"}], ",", 
                RowBox[{"#1", "[", "\"\<survivingFraction\>\"", "]"}]}], 
               "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"thetaSweepResults", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "[", "\"\<beta\>\"", "]"}], "===", 
                "fixedBeta"}], "&"}]}], "]"}]}]}], ";", 
          RowBox[{
           RowBox[{"\"\<beta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"fixedBeta", ",", "InputForm"}], "]"}]}], "->", 
           RowBox[{"Prepend", "[", 
            RowBox[{"sweepRows", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<theta\>\"", ",", "\"\<surviving_fraction\>\""}], 
              "}"}]}], "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"fixedBeta", ",", "thetaSweepBetaValues"}], "}"}]}], "]"}]}], 
    ";", 
    RowBox[{"thetaSweepWorkbook", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<theta_sweeps_at_fixed_beta.xlsx\>\""}], "}"}], "]"}]}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{
     "thetaSweepWorkbook", ",", "thetaSweepSheets", ",", "\"\<XLSX\>\""}], 
     "]"}], ";", 
    RowBox[{"beta001SweepData", "=", 
     RowBox[{"Rest", "[", 
      RowBox[{"\"\<beta=0.001\>\"", "/.", " ", "thetaSweepSheets"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9745891172356663`*^9, 3.974589167746689*^9}, {
   3.974589537857877*^9, 3.974589540950223*^9}, {3.97459054406577*^9, 
   3.974590574074696*^9}, {3.9745912039665756`*^9, 3.974591291709732*^9}, {
   3.9746286561662903`*^9, 3.974628682674624*^9}, {3.97471049481841*^9, 
