   3.974510365824415*^9}, {3.974510434932261*^9, 3.97451049967525*^9}, {
   3.974510577100459*^9, 3.974510584457912*^9}, {3.974511658529981*^9, 
   3.974511662404325*^9}, {3.974511697931278*^9, 3.974511739023265*^9}, {
   3.974511775309317*^9, 3.974511776937174*^9}, {3.974534580771101*^9, 
   3.974534630325029*^9}, 3.97453468457865*^9, {3.974535420209444*^9, 
   3.974535420461661*^9}, 3.974537646769373*^9, {3.974545595271777*^9, 
   3.97454559556862*^9}, 3.974545894694749*^9, 3.974560254115102*^9, {
   3.974560300126451*^9, 3.974560300289281*^9}, {3.974560346734217*^9, 
   3.9745603473004236`*^9}, {3.974560540336397*^9, 3.974560555884906*^9}, 
   3.974562824112054*^9, {3.974570612375031*^9, 3.974570613060363*^9}, {
   3.974588226596137*^9, 3.974588226731371*^9}, {3.97462723025177*^9, 
   3.97462723031608*^9}, 3.974628636687725*^9, {3.97464260870838*^9, 
   3.974642610995283*^9}, {3.974642858551351*^9, 3.974642858840925*^9}, {
   3.974650338626787*^9, 3.974650338822741*^9}, {3.974650369647625*^9, 
   3.974650378912615*^9}, 3.97465049751964*^9, {3.974681245510757*^9, 
   3.974681245586139*^9}, {3.9746838000711517`*^9, 3.974683800208235*^9}, {
   3.974988391715584*^9, 3.9749884092499228`*^9}, {3.974996025588875*^9, 
