Cell[CellGroupData[{

Cell["\<\
Plot the surviving-species fraction over theta on a linear axis and beta on a \
logarithmic axis.\
\>", "Subsection",
 CellChangeTimes->{{3.993598826364541*^9, 
  3.993598840599669*^9}},ExpressionUUID->"c9966a27-45c6-4119-bd9c-\
ffe25c18d1de"],

Cell["\<\
This  plot  can  be  expensive  because  each  sampled  point  evaluates  the \
 parametric  numerical  solution .\
\>", "Text",
 CellChangeTimes->{{3.993598841996375*^9, 
  3.993598846903007*^9}},ExpressionUUID->"4ebeb654-d01d-493f-a3b1-\
cca595900b3f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"p", "=", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"survive", "[", 
      RowBox[{"\[Theta]", ",", "\[Beta]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Beta]", ",", 
       SuperscriptBox["10", 
        RowBox[{"-", "4"}]], ",", 
       SuperscriptBox["10", "4"]}], "}"}], ",", 
     RowBox[{"ScalingFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.97451657742636*^9, 3.974516639972067*^9}, 
   3.974516760506211*^9, {3.974517280948268*^9, 3.9745172864838247`*^9}, {
