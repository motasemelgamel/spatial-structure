\>", "Text",
 CellChangeTimes->{{3.993680872869659*^9, 3.993680874473748*^9}, {
  3.993724363975398*^9, 
  3.993724438701596*^9}},ExpressionUUID->"fb1e1ae1-7db7-4fda-a9bc-\
55a50bdebd17"],

Cell["\<\
Workflow for the single-resource model, parameter sweeps, and \
multiple-nutrient extension. Evaluate each section from top to bottom because \
later cells use definitions created earlier in the same section. This \
notebook reproduces data used in figure 2.\
\>", "Text",
 CellChangeTimes->{{3.993595069261725*^9, 3.993595069444324*^9}, 
   3.9936583275829477`*^9, {3.993724789888117*^9, 
   3.993724791718137*^9}},ExpressionUUID->"71fb7b94-3255-45d0-9145-\
91e66218bca3"],

Cell[CellGroupData[{

Cell["1. Single-resource, multiple-species model", "Section",
 CellChangeTimes->{{3.9936588982703857`*^9, 
  3.993658924101501*^9}},ExpressionUUID->"3670677e-8482-4f2e-a2c9-\
4be01a65da15"],

Cell["\<\
Core notation: S is species richness; n[t] and T[t] are species abundance and \
local resource vectors; R[t] is the shared resource; alpha is the species \
nutrient preferences vector; theta and beta are the two parameters scanned \
below. The first cell clears Global context, so evaluate it before the \
remaining cells in this section.
This section reproduces data used in figure 2.\
\>", "Text",
 CellChangeTimes->{{3.993595091002399*^9, 3.99359509629683*^9}, {
  3.993597898229898*^9, 3.993597898600518*^9}, {3.993658927491393*^9, 
  3.993658947234733*^9}, {3.993658987769961*^9, 
  3.993659015636057*^9}},ExpressionUUID->"d186f9bd-c759-4704-8ec3-\
5cbe95068566"],

Cell[CellGroupData[{

Cell["Model setup", "Subsection",ExpressionUUID->"051e3102-f2f0-47a7-82bc-0a5846e5066b"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "1"}], ";", " ", 
   RowBox[{"\[Gamma]", "=", "0.01"}], ";", " ", 
   RowBox[{"Rstar", "=", "5"}], ";", "  ", 
   RowBox[{"S", "=", "50"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Fix", " ", "the", " ", "random", " ", "stream", " ", "for", " ", 
    "reproducible", " ", "species", " ", "traits"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "S"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"\[Alpha]", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "t_", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<n\>\"", "<>", 
        RowBox[{"ToString", "@", "i"}]}], "]"}], "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "t_", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<T\>\"", "<>", 
        RowBox[{"ToString", "@", "i"}]}], "]"}], "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"1", ",", "S"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"Rstar", ",", "S"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incond", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"n", "[", "0", "]"}], "==", "n0"}], "]"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"T", "[", "0", "]"}], "==", "T0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"R", "[", "0", "]"}], "==", "Rstar"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"R", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{"Rstar", " ", "-", " ", 
        RowBox[{"R", "[", "t", "]"}], "-", 
        RowBox[{"\[Beta]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"S", " ", 
            RowBox[{"R", "[", "t", "]"}]}], " ", "-", 
           RowBox[{"Total", "[", 
            RowBox[{"T", "[", "t", "]"}], "]"}]}], ")"}]}], " ", "-", " ", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"R", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Theta]"}], ")"}], " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Thread", "[", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"n", "[", "t", "]"}]}], "]"}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"n", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"n", "[", "t", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Theta]", " ", 
            RowBox[{"T", "[", "t", "]"}]}], "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Theta]"}], ")"}], " ", 
            RowBox[{"R", "[", "t", "]"}]}]}], " ", ")"}]}], "-", 
        RowBox[{"k", " ", 
         RowBox[{"n", "[", "t", "]"}]}]}]}], "]"}], "\[IndentingNewLine]", 
     ",", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"T", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{
        RowBox[{"\[Beta]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"R", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"T", "[", "t", "]"}]}], ")"}]}], " ", "-", " ", 
        RowBox[{"\[Alpha]", " ", "\[Gamma]", " ", "\[Theta]", " ", 
         RowBox[{"T", "[", "t", "]"}], " ", 
         RowBox[{"n", "[", "t", "]"}]}]}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.974505472855215*^9, 3.97450558160867*^9}, {
   3.974505637410844*^9, 3.974505916957452*^9}, {3.974505947587788*^9, 
