   3.993599837469962*^9, 3.993599837830692*^9}, {3.99363041061838*^9, 
   3.993630411938198*^9}, {3.993640491633408*^9, 3.993640494030783*^9}, 
   3.993682065798596*^9, 3.9936824766275377`*^9},
