09b6b0ed2773"],

Cell["\<\
Build all requested nutrient-presence cases as independent parallel tasks and \
use the existing extinction rule plus guarded steady-state stopping. The \
first workbook sweeps theta for five named scenarios; the second holds theta \
at 0, 0.5, and 1 while increasing the number of poor nutrients.\
\>", "Text",ExpressionUUID->"170001d5-1874-4a06-8ad8-6739943c11b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Configure", " ", "scheduled", " ", "steady"}], "-", 
    RowBox[{
    "state", " ", "checks", " ", "shared", " ", "by", " ", "every", " ", 
     "multiple"}], "-", 
    RowBox[{"nutrient", " ", 
     RowBox[{"task", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", "5000"}], ";", 
    RowBox[{"thresh", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}], ";", 
    RowBox[{"betaForNutrientSweeps", "=", "1"}], ";", 
    RowBox[{"thetaGrid", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "1", ",", "0.01`"}], "]"}], "]"}]}], ";", 
    RowBox[{"thetaCases", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0.5`", ",", "1"}], "}"}]}], ";", 
    RowBox[{"poorNutrientCounts", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Length", "[", "deltaTraits", "]"}]}], "]"}]}], ";", 
    RowBox[{"steadyStateTolerance", "=", 
     FractionBox["1", 
      SuperscriptBox["10", "4"]]}], ";", 
    RowBox[{"steadyStateMinimumTime", "=", "100"}], ";", 
    RowBox[{"steadyStateCheckInterval", "=", "25"}], ";", 
    RowBox[{"steadyStateAbundanceSafetyFactor", "=", "10"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Solve", " ", "one", " ", "nutrient"}], "-", 
     RowBox[{
     "presence", " ", "case", " ", "and", " ", "return", " ", "its", " ", 
      "survivor", " ", "fraction", " ", "plus", " ", "actual", " ", 
      "stopping", " ", 
      RowBox[{"time", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"integrationEndTime", ",", "multipleNutrientSurvivalAt"}], "]"}],
     ";", 
    RowBox[{
     RowBox[{"integrationEndTime", "[", "solution_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "functions", "}"}], ",", 
       RowBox[{
        RowBox[{"functions", "=", 
         RowBox[{"Head", "/@", "solution"}]}], ";", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"First", "[", 
              RowBox[{"#1", "[", "\"\<Domain\>\"", "]"}], "]"}], "]"}], "&"}],
            ")"}], "/@", "functions"}], "]"}]}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"multipleNutrientSurvivalAt", "[", 
      RowBox[{"alphaPresent_", ",", "poorNutrientCount_Integer", ",", 
       RowBox[{"thetaValue_", "?", "NumericQ"}], ",", 
       RowBox[{"betaValue_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numericEquations", ",", "equationRightSides", ",", "stateVector", 
         ",", "extinctionConditions", ",", "extinctionActions", ",", 
         "extinctionEvents", ",", "classificationStable", ",", 
         "steadyStateCheckTimes", ",", "steadyStateEvents", ",", "solution", 
         ",", "finalTime", ",", "finalState", ",", "finalAbundances"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"numericEquations", "=", 
         RowBox[{
          RowBox[{"buildNutrientEquations", "[", 
           RowBox[{"alphaPresent", ",", "poorNutrientCount"}], "]"}], "/.", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]", "->", "thetaValue"}], ",", 
            RowBox[{"\[Beta]", "->", "betaValue"}]}], "}"}]}]}], ";", 
        RowBox[{"equationRightSides", "=", 
         RowBox[{"Last", "/@", "numericEquations"}]}], ";", 
        RowBox[{"stateVector", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], ",", 
           RowBox[{"T", "[", "t", "]"}], ",", 
           RowBox[{"Ttilde", "[", "t", "]"}], ",", 
           RowBox[{"Tbar", "[", "t", "]"}], ",", 
           RowBox[{"Tbar1new", "[", "t", "]"}], ",", 
           RowBox[{"Tbar2new", "[", "t", "]"}], ",", 
           RowBox[{"Tbar3new", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"R", "[", "t", "]"}], ",", 
             RowBox[{"Rtilde", "[", "t", "]"}], ",", 
             RowBox[{"Rbar", "[", "t", "]"}], ",", 
             RowBox[{"Rbar1", "[", "t", "]"}], ",", 
             RowBox[{"Rbar2", "[", "t", "]"}], ",", 
             RowBox[{"Rbar3", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
        RowBox[{"extinctionConditions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "<", "thresh"}], "]"}]}], ";", 
        RowBox[{"extinctionActions", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"n", "[", "t", "]"}], "->", "0"}], "]"}]}], ";", 
        RowBox[{"extinctionEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionConditions", ",", "speciesIndex"}], "]"}], 
              "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{"Extract", "[", 
               RowBox[{"extinctionActions", ",", "speciesIndex"}], "]"}], 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"speciesIndex", ",", "S"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"classificationStable", "=", 
         RowBox[{"And", "@@", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", "==", "0"}], "||", 
              RowBox[{"#1", ">=", 
               RowBox[{
               "steadyStateAbundanceSafetyFactor", " ", "thresh"}]}]}], "&"}],
             ")"}], "/@", 
           RowBox[{"n", "[", "t", "]"}]}]}]}], ";", 
        RowBox[{"steadyStateCheckTimes", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
          "steadyStateMinimumTime", ",", "lim", ",", 
           "steadyStateCheckInterval"}], "]"}]}], ";", 
        RowBox[{"steadyStateEvents", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"checkTime", "=", "scheduledTime"}], "}"}], ",", 
             RowBox[{"WhenEvent", "[", 
              RowBox[{
               RowBox[{"Evaluate", "[", 
                RowBox[{
                 RowBox[{"t", "==", "checkTime"}], "&&", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"Abs", "[", "equationRightSides", "]"}], "]"}], 
                  "<", "steadyStateTolerance"}], "&&", 
                 "classificationStable"}], "]"}], ",", 
               "\"\<StopIntegration\>\""}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"scheduledTime", ",", "steadyStateCheckTimes"}], "}"}]}], 
          "]"}]}], ";", 
        RowBox[{"solution", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
            "numericEquations", ",", "incond", ",", "extinctionEvents", ",", 
             "steadyStateEvents"}], "]"}], ",", "stateVector", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "lim"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"finalTime", "=", 
         RowBox[{"integrationEndTime", "[", "solution", "]"}]}], ";", 
        RowBox[{"finalState", "=", 
         RowBox[{"N", "[", 
          RowBox[{"solution", "/.", " ", 
           RowBox[{"t", "->", "finalTime"}]}], "]"}]}], ";", 
        RowBox[{"finalAbundances", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"finalState", ",", "S"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           FractionBox[
            RowBox[{"Count", "[", 
             RowBox[{"finalAbundances", ",", 
              RowBox[{"abundance_", "/;", 
               RowBox[{
                RowBox[{"NumericQ", "[", "abundance", "]"}], "&&", 
                RowBox[{"abundance", ">", "thresh"}]}]}]}], "]"}], "S"], 
           "]"}], ",", "finalTime"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Create", " ", "all", " ", "workbook", " ", "rows", " ", "as", " ", 
     "independent", " ", "tasks", " ", "before", " ", "starting", " ", 
     "parallel", " ", 
     RowBox[{"kernels", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaScenarioTasks", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<kind\>\"", "->", "\"\<theta\>\""}], ",", 
           RowBox[{"\"\<sheet\>\"", "->", 
            RowBox[{"scenario", "[", "\"\<sheet\>\"", "]"}]}], ",", 
           RowBox[{"\"\<alphaPresent\>\"", "->", 
            RowBox[{"scenario", "[", "\"\<alphaPresent\>\"", "]"}]}], ",", 
           RowBox[{"\"\<poorNutrientCount\>\"", "->", 
            RowBox[{"scenario", "[", "\"\<poorNutrientCount\>\"", "]"}]}], 
           ",", 
           RowBox[{"\"\<theta\>\"", "->", "thetaValue"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"scenario", ",", "nutrientScenarios"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"thetaValue", ",", "thetaGrid"}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";", 
    RowBox[{"poorNutrientTasks", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<kind\>\"", "->", "\"\<poor\>\""}], ",", 
           RowBox[{"\"\<sheet\>\"", "->", 
            RowBox[{"\"\<theta=\>\"", "<>", 
             RowBox[{"ToString", "[", "thetaValue", "]"}]}]}], ",", 
           RowBox[{"\"\<alphaPresent\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<poorNutrientCount\>\"", "->", "poorNutrientCount"}], 
           ",", 
           RowBox[{"\"\<theta\>\"", "->", "thetaValue"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"thetaValue", ",", "thetaCases"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"poorNutrientCount", ",", "poorNutrientCounts"}], "}"}]}], 
        "]"}], ",", "1"}], "]"}]}], ";", 
    RowBox[{"nutrientSweepTasks", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"thetaScenarioTasks", ",", "poorNutrientTasks"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Distribute", " ", "the", " ", "model", " ", "once", " ", "and", " ", 
     "calculate", " ", "all", " ", "nutrient", " ", "tasks", " ", 
     RowBox[{"concurrently", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$KernelCount", "==", "0"}], ",", 
      RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "integrationEndTime", ",", "multipleNutrientSurvivalAt", ",", 
      "buildNutrientEquations", ",", "eqTemplate", ",", "alphaTraits", ",", 
      "deltaTraits", ",", "zeroTraits", ",", "alphaPlaceholders", ",", 
      "deltaPlaceholders", ",", "incond", ",", "n", ",", "T", ",", "Ttilde", 
      ",", "Tbar", ",", "Tbar1new", ",", "Tbar2new", ",", "Tbar3new", ",", 
      "t", ",", "S", ",", "lim", ",", "thresh", ",", "betaForNutrientSweeps", 
      ",", "steadyStateTolerance", ",", "steadyStateMinimumTime", ",", 
      "steadyStateCheckInterval", ",", "steadyStateAbundanceSafetyFactor"}], 
     "]"}], ";", 
    RowBox[{"nutrientSweepResults", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"task", ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"solveResult", "=", 
             RowBox[{"multipleNutrientSurvivalAt", "[", 
              RowBox[{
               RowBox[{"task", "[", "\"\<alphaPresent\>\"", "]"}], ",", 
               RowBox[{"task", "[", "\"\<poorNutrientCount\>\"", "]"}], ",", 
               RowBox[{"task", "[", "\"\<theta\>\"", "]"}], ",", 
               "betaForNutrientSweeps"}], "]"}]}], "}"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{"task", ",", 
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"\"\<survivingFraction\>\"", "->", 
                RowBox[{"First", "[", "solveResult", "]"}]}], ",", 
               RowBox[{"\"\<stopTime\>\"", "->", 
                RowBox[{"Last", "[", "solveResult", "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}], "]"}], ",", "nutrientSweepTasks", ",", 
       RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Assemble", " ", "both", " ", "workbook", " ", "layouts", " ", "while", 
     " ", "keeping", " ", "stop", " ", "times", " ", "in", " ", 
     "nutrientSweepResults", " ", "for", " ", 
     RowBox[{"diagnostics", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaSweepSheets", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "sweepRows", "}"}], ",", 
         RowBox[{
          RowBox[{"sweepRows", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#1", "[", "\"\<theta\>\"", "]"}], ",", 
                RowBox[{"#1", "[", "\"\<survivingFraction\>\"", "]"}]}], 
               "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"nutrientSweepResults", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "[", "\"\<kind\>\"", "]"}], "===", 
                 "\"\<theta\>\""}], "&&", 
                RowBox[{
                 RowBox[{"#1", "[", "\"\<sheet\>\"", "]"}], "===", 
                 RowBox[{"scenario", "[", "\"\<sheet\>\"", "]"}]}]}], "&"}]}],
              "]"}]}]}], ";", 
          RowBox[{
           RowBox[{"scenario", "[", "\"\<sheet\>\"", "]"}], "->", 
           RowBox[{"Prepend", "[", 
            RowBox[{"sweepRows", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<theta\>\"", ",", "\"\<surviving_fraction\>\""}], 
              "}"}]}], "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"scenario", ",", "nutrientScenarios"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"poorNutrientCountSheets", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sheetName", ",", "sweepRows"}], "}"}], ",", 
         RowBox[{
          RowBox[{"sheetName", "=", 
           RowBox[{"\"\<theta=\>\"", "<>", 
            RowBox[{"ToString", "[", "fixedTheta", "]"}]}]}], ";", 
          RowBox[{"sweepRows", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#1", "[", "\"\<poorNutrientCount\>\"", "]"}], ",", 
                RowBox[{"#1", "[", "\"\<survivingFraction\>\"", "]"}]}], 
               "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"nutrientSweepResults", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "[", "\"\<kind\>\"", "]"}], "===", 
                 "\"\<poor\>\""}], "&&", 
                RowBox[{
                 RowBox[{"#1", "[", "\"\<sheet\>\"", "]"}], "===", 
                 "sheetName"}]}], "&"}]}], "]"}]}]}], ";", 
          RowBox[{"sheetName", "->", 
           RowBox[{"Prepend", "[", 
            RowBox[{"sweepRows", ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<number_of_poor_nutrients\>\"", ",", 
               "\"\<surviving_fraction\>\""}], "}"}]}], "]"}]}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"fixedTheta", ",", "thetaCases"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Export", " ", "both", " ", "workbooks", " ", "beside", " ", "the", " ", 
     "notebook", " ", "after", " ", "all", " ", "parallel", " ", "tasks", " ", 
     RowBox[{"finish", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"outputDirectory", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", "$Failed"}], "]"}], 
      "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"StringQ", "[", "outputDirectory", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "outputDirectory", "]"}]}]}], ",", 
      RowBox[{"outputDirectory", "=", 
       RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", 
    RowBox[{"thetaSweepWorkbook", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "outputDirectory", ",", 
        "\"\<survival_vs_theta_by_nutrient_scenario.xlsx\>\""}], "}"}], 
      "]"}]}], ";", 
    RowBox[{"poorNutrientWorkbook", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "outputDirectory", ",", 
        "\"\<survival_vs_number_of_poor_nutrients.xlsx\>\""}], "}"}], "]"}]}],
     ";", 
    RowBox[{"Export", "[", 
     RowBox[{
     "thetaSweepWorkbook", ",", "thetaSweepSheets", ",", "\"\<XLSX\>\""}], 
     "]"}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{
     "poorNutrientWorkbook", ",", "poorNutrientCountSheets", ",", 
      "\"\<XLSX\>\""}], "]"}], ";"}]}]}]], "Input",
