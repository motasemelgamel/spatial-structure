Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Keep", " ", "an", " ", "unevaluated", " ", "equation", " ", "template"}],
     ",", " ", 
    RowBox[{
    "then", " ", "activate", " ", "only", " ", "the", " ", "requested", " ", 
     "nutrient", " ", 
     RowBox[{"traits", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqTemplate", "=", "eq"}], ";", 
    RowBox[{"\[Alpha]", "=", "alphaTraits"}], ";", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Delta]1", ",", "\[Delta]2", ",", "\[Delta]3", ",", "\[Delta]4", ",", 
       "\[Delta]5"}], "}"}], "=", "deltaTraits"}], ";", 
    RowBox[{"ClearAll", "[", "buildNutrientEquations", "]"}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"buildNutrientEquations", "[", 
       RowBox[{"alphaPresent_", ",", "poorNutrientCount_Integer"}], "]"}], "/;", 
      RowBox[{"0", "<=", "poorNutrientCount", "<=", 
       RowBox[{"Length", "[", "deltaTraits", "]"}]}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"activeAlpha", ",", "activeDeltas", ",", "traitRules"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"activeAlpha", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "alphaPresent", "]"}], ",", "alphaTraits", 
           ",", "zeroTraits"}], "]"}]}], ";", 
        RowBox[{"activeDeltas", "=", 
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "#2", "]"}], "<=", "poorNutrientCount"}],
               ",", "#1", ",", "zeroTraits"}], "]"}], "&"}], ",", 
           "deltaTraits"}], "]"}]}], ";", 
        RowBox[{"traitRules", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{"alphaPlaceholders", "->", "activeAlpha"}], "]"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Thread", "[", 
                RowBox[{"#1", "->", "#2"}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"deltaPlaceholders", ",", "activeDeltas"}], "}"}]}], 
             "]"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"eqTemplate", "/.", " ", "traitRules"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "List", " ", "the", " ", "five", " ", "requested", " ", "cumulative", " ",
      "nutrient", " ", "scenarios", " ", "in", " ", "Excel", " ", "tab", " ", 
     
     RowBox[{"order", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nutrientScenarios", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<sheet\>\"", "->", "\"\<alpha_only\>\""}], ",", 
         RowBox[{"\"\<alphaPresent\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<poorNutrientCount\>\"", "->", "0"}]}], "]"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<sheet\>\"", "->", "\"\<delta1_only\>\""}], ",", 
         RowBox[{"\"\<alphaPresent\>\"", "->", "False"}], ",", 
         RowBox[{"\"\<poorNutrientCount\>\"", "->", "1"}]}], "]"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<sheet\>\"", "->", "\"\<alpha_delta1\>\""}], ",", 
         RowBox[{"\"\<alphaPresent\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<poorNutrientCount\>\"", "->", "1"}]}], "]"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<sheet\>\"", "->", "\"\<alpha_delta1_delta2\>\""}], ",", 
         
         RowBox[{"\"\<alphaPresent\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<poorNutrientCount\>\"", "->", "2"}]}], "]"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{
         "\"\<sheet\>\"", "->", "\"\<alpha_delta1_delta2_delta3\>\""}], ",", 
         RowBox[{"\"\<alphaPresent\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<poorNutrientCount\>\"", "->", "3"}]}], "]"}]}], "}"}]}],
     ";", 
    RowBox[{"scenarioEquations", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"scenario", "[", "\"\<sheet\>\"", "]"}], "->", 
         RowBox[{"buildNutrientEquations", "[", 
          RowBox[{
           RowBox[{"scenario", "[", "\"\<alphaPresent\>\"", "]"}], ",", 
           RowBox[{"scenario", "[", "\"\<poorNutrientCount\>\"", "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"scenario", ",", "nutrientScenarios"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
