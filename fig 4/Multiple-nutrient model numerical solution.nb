Cell[CellGroupData[{
Cell["Multiple-nutrient model numerical solution", "Title",
 CellChangeTimes->{{3.993724814084658*^9, 3.993724892384969*^9}, {
  3.993724973321138*^9, 
  3.993724974464592*^9}},ExpressionUUID->"4d0b0f06-8607-4bc6-896c-\
a2fd11f6102f"],

Cell["\<\
Disclaimer : This  notebook  was  written  and  revised  with  assistance  \
from  OpenAI  Codex . The  author  remains  responsible  for  verifying  all  \
results .
   
This  notebook  starts  with  ClearAll  and  extends  the  model  to  several \
 shared  and  local  nutrient  pools . Evaluate  its  setup, equations, and  \
parametric  solver  in  order  before  running  the  export  cell . This  \
notebook  reproduces  data  used  in  figure  4.\
\>", "Text",
 CellChangeTimes->{{3.993724893678649*^9, 
  3.993724912096208*^9}},ExpressionUUID->"8690b071-b9df-4e1b-acaa-\
d3033d209f7b"],

Cell[CellGroupData[{

Cell["Parameters and reproducible species traits", "Subsection",ExpressionUUID->"11e62eb9-1d34-4a20-aa3c-352c76de0b42"],

Cell["\<\
Set the common constants and species count. The explicit alpha vector that \
follows the exploratory RandomReal draw fixes the trait realization used by \
this analysis.\
\>", "Text",ExpressionUUID->"8b4b3236-97e3-4c50-87a2-eebe26e386a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Multiple", " ", "Nutrients"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"k", "=", "1"}], ";", " ", 
    RowBox[{"\[Gamma]", "=", "0.01"}], ";", " ", 
    RowBox[{"Rstar", "=", "5"}], ";", "  ", 
    RowBox[{"S", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Fix", " ", "the", " ", "random", " ", "stream", " ", "for", " ", 
     "reproducible", " ", "species", " ", "traits"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "S"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"\[Alpha]", "=", 
     RowBox[{"\[Alpha]", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975084002174608*^9, 3.975084002803423*^9}, {
  3.975109637948531*^9, 3.975109643061743*^9}, {3.9812991925050707`*^9, 
